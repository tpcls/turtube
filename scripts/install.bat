@echo off
setlocal EnableDelayedExpansion

:: ????????????????????????????????????????????????????????????????????
:: ?     Video ASCII Converter ? Windows 자동 설치 스크립트           ?
:: ?  NVIDIA GPU → CUDA (PyTorch)                                     ?
:: ?  그 외 → CPU (numpy + opencv)                                    ?
:: ????????????????????????????????????????????????????????????????????

echo.
echo  ???   ????????????? ???????? ???????      ?????? ???????? ?????????????
echo  ???   ???????????????????????????????    ??????????????????????????????
echo  ???   ?????????  ?????????  ???   ???    ???????????????????     ??????
echo  ???? ??????????  ?????????  ???   ???    ???????????????????     ??????
echo   ??????? ????????????????????????????    ???  ?????????????????????????
echo    ?????  ?????????? ???????? ???????     ???  ??????????? ?????????????
echo                GPU-Accelerated Video -^> ASCII Art  ^|  Windows Auto Installer
echo.

set "SCRIPT_DIR=%~dp0"
set "PROJECT_DIR=%SCRIPT_DIR%.."
pushd "%PROJECT_DIR%"
set "PROJECT_DIR=%CD%"
popd

set "VENV_DIR=%PROJECT_DIR%\venv_ascii"
set "PIP=%VENV_DIR%\Scripts\pip.exe"
set "PYTHON_VENV=%VENV_DIR%\Scripts\python.exe"

:: ??????????????????????????????????????????????????????????????????
:: 1. Python 버전 확인 (3.9+)
:: ??????????????????????????????????????????????????????????????????
echo [INFO] Python 버전 확인 중...

set "PYTHON="
for %%C in (python3.12 python3.11 python3.10 python3.9 python3 python) do (
    if "!PYTHON!"=="" (
        for /f "tokens=*" %%P in ('where %%C 2^>nul') do (
            if "!PYTHON!"=="" (
                :: Microsoft Store 더미 Python(WindowsApps) 제외
                echo %%P | findstr /i "WindowsApps" >nul 2>&1
                if !ERRORLEVEL! neq 0 (
                    for /f "tokens=*" %%V in ('"%%P" -c "import sys; print(f\"{sys.version_info.major}.{sys.version_info.minor}\")" 2^>nul') do (
                        set "VER=%%V"
                    )
                    if defined VER (
                        for /f "tokens=1,2 delims=." %%A in ("!VER!") do (
                            set "MAJOR=%%A"
                            set "MINOR=%%B"
                        )
                        if !MAJOR! GEQ 3 (
                            if !MINOR! GEQ 9 (
                                set "PYTHON=%%P"
                                echo [OK] Python !VER! 발견: %%P
                            )
                        )
                    )
                )
            )
        )
    )
)

if "!PYTHON!"=="" (
    echo [ERROR] Python 3.9+ 를 찾을 수 없습니다.
    echo.
    :: scripts 폴더에 Python 인스톨러 있는지 확인
    if exist "%SCRIPT_DIR%python_install.exe" (
        echo [INFO] scripts\python_install.exe 발견!
        echo        Python 설치를 시작하시겠습니까?
        set /p "DO_INSTALL=  Python 자동 설치? [Y/n] "
        if /i not "!DO_INSTALL!"=="n" (
            echo [INFO] Python 설치 중... (설치 완료 후 install.bat를 다시 실행하세요)
            start /wait "" "%SCRIPT_DIR%python_install.exe" /quiet InstallAllUsers=0 PrependPath=1 Include_pip=1
            echo [INFO] Python 설치 완료. 이 스크립트를 다시 실행해 주세요.
            pause
            exit /b 0
        )
    )
    echo        다음 방법 중 하나로 Python을 설치하세요:
    echo.
    echo        1. Python 공식 설치 (권장):
    echo           https://www.python.org/downloads/
    echo           설치 시 "Add Python to PATH" 옵션을 반드시 체크!
    echo.
    echo        2. winget 사용:
    echo           winget install Python.Python.3.11
    echo.
    echo        설치 후 새 명령 프롬프트 창을 열고 install.bat를 다시 실행하세요.
    pause
    exit /b 1
)

:: ??????????????????????????????????????????????????????????????????
:: 2. venv 설정
:: ??????????????????????????????????????????????????????????????????
echo.
echo [INFO] 가상환경(venv) 설정 중...

if exist "%VENV_DIR%" (
    echo [WARN] 기존 venv 발견: %VENV_DIR%
    set /p "REUSE=  재사용하시겠습니까? [Y/n] "
    if /i "!REUSE!"=="n" (
        echo [INFO] 기존 venv 삭제 후 재생성...
        rmdir /s /q "%VENV_DIR%"
        !PYTHON! -m venv "%VENV_DIR%"
    )
) else (
    !PYTHON! -m venv "%VENV_DIR%"
)

if not exist "%PYTHON_VENV%" (
    echo [ERROR] venv 생성 실패
    exit /b 1
)

"%PIP%" install --upgrade pip setuptools wheel -q
echo [OK] 가상환경 준비 완료: %VENV_DIR%

:: ??????????????????????????????????????????????????????????????????
:: 3. 공통 의존성 설치
:: ??????????????????????????????????????????????????????????????????
echo.
echo [INFO] 공통 패키지 설치 중 (opencv, numpy, Pillow, yt-dlp, numba)...

"%PIP%" install --upgrade ^
    "opencv-python-headless>=4.8" ^
    "numpy>=1.24" ^
    "Pillow>=10.0" ^
    "yt-dlp>=2024.1.1" ^
    "numba>=0.57" ^
    -q

echo [OK] 공통 패키지 설치 완료

:: ??????????????????????????????????????????????????????????????????
:: 4. ffmpeg 설치 확인
:: ??????????????????????????????????????????????????????????????????
echo.
echo [INFO] ffmpeg 설치 확인 중...

where ffmpeg >nul 2>&1
if !ERRORLEVEL! == 0 (
    for /f "tokens=*" %%V in ('ffmpeg -version 2^>^&1 ^| findstr /i "ffmpeg version"') do echo [OK] %%V
) else (
    echo [WARN] ffmpeg 가 PATH에 없습니다.
    echo        다음 방법 중 하나로 설치하세요:
    echo.
    echo        1. winget 사용 (권장):
    echo           winget install Gyan.FFmpeg
    echo.
    echo        2. 수동 설치:
    echo           https://www.gyan.dev/ffmpeg/builds/ 에서 다운로드 후
    echo           압축 해제 후 bin 폴더를 PATH에 추가
    echo.
    echo        3. Chocolatey 사용:
    echo           choco install ffmpeg
    echo.
    echo        ffmpeg 없이도 로컬 파일 재생은 가능하지만 MP4 저장은 불가합니다.
)

:: ??????????????????????????????????????????????????????????????????
:: 5. GPU 백엔드 감지 및 설치 (CUDA)
:: ??????????????????????????????????????????????????????????????????
echo.
echo [INFO] GPU 백엔드 감지 중...

set "BACKEND_INSTALLED=cpu"
set "CUDA_MAJOR=0"

:: NVIDIA GPU 확인 (nvidia-smi)
where nvidia-smi >nul 2>&1
if !ERRORLEVEL! == 0 (
    echo [INFO] NVIDIA GPU 감지됨

    :: CUDA 버전 추출
    for /f "tokens=*" %%L in ('nvidia-smi 2^>nul ^| findstr /i "CUDA Version"') do (
        set "CUDA_LINE=%%L"
    )

    :: CUDA 버전 파싱 (예: "CUDA Version: 12.4" -> 12)
    if defined CUDA_LINE (
        for /f "tokens=3 delims=: " %%V in ("!CUDA_LINE!") do (
            for /f "tokens=1 delims=." %%M in ("%%V") do set "CUDA_MAJOR=%%M"
        )
        echo [INFO] 감지된 CUDA 버전: !CUDA_LINE!
    )

    :: PyTorch CUDA 버전 선택
    set "TORCH_INDEX="
    if !CUDA_MAJOR! GEQ 12 (
        set "TORCH_INDEX=https://download.pytorch.org/whl/cu124"
        echo [INFO] CUDA 12.x 감지 → PyTorch cu124 설치
    ) else if !CUDA_MAJOR! EQU 11 (
        set "TORCH_INDEX=https://download.pytorch.org/whl/cu118"
        echo [INFO] CUDA 11.x 감지 → PyTorch cu118 설치
    ) else (
        set "TORCH_INDEX=https://download.pytorch.org/whl/cpu"
        echo [WARN] CUDA 11 미만 감지 → CPU PyTorch 설치
    )

    echo [INFO] PyTorch 설치 중 (index: !TORCH_INDEX!) ...
    "%PIP%" install torch torchvision --index-url "!TORCH_INDEX!" -q

    :: CUDA 사용 가능 여부 확인
    "%PYTHON_VENV%" -c "import torch; exit(0 if torch.cuda.is_available() else 1)" >nul 2>&1
    if !ERRORLEVEL! == 0 (
        for /f "tokens=*" %%D in ('"%PYTHON_VENV%" -c "import torch; print(torch.cuda.get_device_name(0))" 2^>nul') do set "GPU_NAME=%%D"
        echo [OK] PyTorch CUDA 설치 확인: !GPU_NAME!
        set "BACKEND_INSTALLED=cuda"

        :: CuPy 추가 설치 (선택적 가속)
        set "CUPY_PKG="
        if !CUDA_MAJOR! GEQ 12 set "CUPY_PKG=cupy-cuda12x"
        if !CUDA_MAJOR! EQU 11 set "CUPY_PKG=cupy-cuda11x"

        if defined CUPY_PKG (
            echo [INFO] CuPy 설치 중 (!CUPY_PKG!) ...
            "%PIP%" install "!CUPY_PKG!" -q
            if !ERRORLEVEL! == 0 (
                echo [OK] CuPy (!CUPY_PKG!) 설치 완료
            ) else (
                echo [WARN] CuPy 설치 실패 (무시 가능)
            )
        )
    ) else (
        echo [WARN] torch.cuda.is_available() = False → CPU 모드로 진행
    )
) else (
    echo [INFO] NVIDIA GPU 없음 → CPU 모드
)

:: ??????????????????????????????????????????????????????????????????
:: 6. C++ ASCII 엔진 빌드
:: ??????????????????????????????????????????????????????????????????
echo.
echo [INFO] C++ ASCII 엔진 빌드 중...

set "BUILD_SCRIPT=%SCRIPT_DIR%build_cpp.bat"
if exist "%BUILD_SCRIPT%" (
    call "%BUILD_SCRIPT%"
    if !ERRORLEVEL! neq 0 (
        echo [WARN] C++ 엔진 빌드 실패 ? CPU/Python 모드로 동작합니다.
        echo        Visual Studio 또는 MinGW 설치 후 scripts\build_cpp.bat 재실행 가능
    ) else (
        echo [OK] C++ 엔진 빌드 완료 (ascii_engine.dll)
    )
) else (
    echo [WARN] build_cpp.bat 없음: C++ 엔진 빌드 스킵
)

:: ??????????????????????????????????????????????????????????????????
:: 7. 설치 검증
:: ??????????????????????????????????????????????????????????????????
echo.
echo [INFO] 설치 검증 중...

"%PYTHON_VENV%" -c ^"
import sys
results = {}

try:
    import numpy as np
    results['numpy'] = f'OK {np.__version__}'
except ImportError:
    results['numpy'] = 'FAIL 미설치'

try:
    import cv2
    results['opencv'] = f'OK {cv2.__version__}'
except ImportError:
    results['opencv'] = 'FAIL 미설치'

try:
    import PIL
    results['Pillow'] = f'OK {PIL.__version__}'
except ImportError:
    results['Pillow'] = 'FAIL 미설치 (MP4 출력 불가)'

try:
    import numba
    results['numba'] = f'OK {numba.__version__}'
except ImportError:
    results['numba'] = 'SKIP 미설치 (선택사항)'

cuda_ok = False
try:
    import torch
    cuda_ok = torch.cuda.is_available()
    device = torch.cuda.get_device_name(0) if cuda_ok else '없음'
    results['torch'] = f'OK {torch.__version__} | CUDA: {cuda_ok} | GPU: {device}'
except ImportError:
    results['torch'] = 'SKIP 미설치'

try:
    import cupy as cp
    results['cupy'] = f'OK {cp.__version__}'
except ImportError:
    results['cupy'] = 'SKIP 미설치'

try:
    import yt_dlp
    results['yt-dlp'] = f'OK {yt_dlp.version.__version__}'
except ImportError:
    results['yt-dlp'] = 'FAIL 미설치'

print()
for k, v in results.items():
    print(f'  {k:<10} {v}')

if cuda_ok:
    backend = 'CUDA (PyTorch)'
elif results.get('cupy', '').startswith('OK'):
    backend = 'CuPy'
else:
    backend = 'CPU (numpy)'
print(f'\n  선택된 백엔드: {backend}')
^"

:: ??????????????????????????????????????????????????????????????????
:: 8. 실행 스크립트 생성
:: ??????????????????????????????????????????????????????????????????
echo.
echo [INFO] 실행 스크립트 생성 중...

(
    echo @echo off
    echo setlocal
    echo :: video_ascii.py 실행 래퍼 ^(venv 자동 활성화^)
    echo set "SCRIPT_DIR=%%~dp0"
    echo set "PROJECT_DIR=%%SCRIPT_DIR%%"
    echo call "%%PROJECT_DIR%%venv_ascii\Scripts\activate.bat"
    echo python "%%PROJECT_DIR%%src\video_ascii.py" %%*
    echo endlocal
) > "%PROJECT_DIR%\run_ascii.bat"

echo [OK] 실행 스크립트 생성: run_ascii.bat

:: ??????????????????????????????????????????????????????????????????
:: 9. 완료 메시지
:: ??????????????????????????????????????????????????????????????????
set "BACKEND_UPPER=!BACKEND_INSTALLED!"
if "!BACKEND_INSTALLED!"=="cuda" set "BACKEND_UPPER=CUDA"
if "!BACKEND_INSTALLED!"=="cpu"  set "BACKEND_UPPER=CPU"

echo.
echo ????????????????????????????????????????????????????????
echo   [OK] 설치 완료!  백엔드: !BACKEND_UPPER!
echo ????????????????????????????????????????????????????????
echo.
echo 사용 예시:
echo.
echo   # YouTube URL 실시간 재생
echo   run_ascii.bat --url "https://youtu.be/dQw4w9WgXcQ" --width 160 --color
echo.
echo   # URL -^> HTML 저장
echo   run_ascii.bat --url "https://youtu.be/xxxxx" --width 200 --output out.html --color
echo.
echo   # 로컬 파일
echo   run_ascii.bat --input video.mp4 --width 160 --color
echo.
echo   # 웹캠 실시간
echo   run_ascii.bat --webcam --width 120 --color
echo.
echo   또는 venv 직접 활성화:
echo   venv_ascii\Scripts\activate.bat
echo   python src\video_ascii.py --help
echo.

endlocal
pause
